# Salin file ini menjadi `.env` lalu isi nilainya. JANGAN commit file `.env`.

# PostgreSQL connection string.
# Neon: pakai host "-pooler" (PgBouncer) untuk runtime aplikasi.
# Lokal/self-hosted: postgresql://USER:PASSWORD@localhost:5432/po_system
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Secret untuk menandatangani session NextAuth (JWT).
# Generate: `openssl rand -base64 32` (atau `npx auth secret`).
# Wajib berbeda untuk tiap environment (dev/staging/production).
AUTH_SECRET=""

# Zona waktu bisnis untuk penomoran dokumen per bulan (nama zona IANA).
# Default: Asia/Jakarta.
# APP_TIMEZONE="Asia/Jakarta"
