// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Level otoritas approval per tenant (mirip Release Code SAP).
// Nama bebas ditentukan tenant sendiri: "Supervisor", "Manager", dst.
model ApprovalLevel {
  id       String @id @default(uuid())
  tenantId String
  name     String

  tenant    Tenant                 @relation(fields: [tenantId], references: [id])
  approvers ApprovalLevelUser[]    // banyak user bisa berwenang di level yang sama
  steps     ApprovalStrategyStep[]
  logs      ApprovalLog[]

  @@index([tenantId])
}

// M:N — user mana saja yang berwenang approve di suatu ApprovalLevel
model ApprovalLevelUser {
  id              String @id @default(uuid())
  approvalLevelId String
  userId          String

  approvalLevel ApprovalLevel @relation(fields: [approvalLevelId], references: [id])
  user          User          @relation(fields: [userId], references: [id])

  @@unique([approvalLevelId, userId])
}

// Aturan: untuk rentang nominal berapa, strategi approval apa yang berlaku.
// Menggantikan fungsi range-matching yang dulu ada di ApprovalConfig.
model ApprovalStrategy {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  minAmount    Decimal  @db.Decimal(15, 2)
  maxAmount    Decimal? @db.Decimal(15, 2) // null = tak terbatas, hanya boleh 1 per tenant
  isSequential Boolean  @default(false)     // true = step harus urut sesuai `sequence`, false = bebas urutan

  tenant         Tenant                 @relation(fields: [tenantId], references: [id])
  steps          ApprovalStrategyStep[]
  purchaseOrders PurchaseOrder[]

  @@index([tenantId])
}

// Level-level apa saja yang dibutuhkan satu ApprovalStrategy, termasuk urutannya
model ApprovalStrategyStep {
  id                 String @id @default(uuid())
  approvalStrategyId String
  approvalLevelId    String
  sequence           Int    // dipakai hanya jika strategy.isSequential = true

  strategy ApprovalStrategy @relation(fields: [approvalStrategyId], references: [id])
  level    ApprovalLevel    @relation(fields: [approvalLevelId], references: [id])

  @@unique([approvalStrategyId, approvalLevelId])
}

model ApprovalLog {
  id              String   @id @default(uuid())
  poId            String
  approvalLevelId String   // diganti dari `level Int` jadi relasi langsung ke ApprovalLevel
  approverId      String
  action          String   // "APPROVED" | "REJECTED"
  notes           String?
  actedAt         DateTime @default(now())

  po            PurchaseOrder @relation(fields: [poId], references: [id])
  approvalLevel ApprovalLevel @relation(fields: [approvalLevelId], references: [id])
  approver      User          @relation(fields: [approverId], references: [id])

  @@index([poId])
}

model PurchaseOrder {
  id                   String    @id @default(uuid())
  tenantId             String
  poNumber             String    // format: PO-YYYYMM-0001, auto-generated per tenant, reset tiap bulan
  vendorId             String
  createdBy            String    // user id yang membuat PO
  status               String    @default("DRAFT") // divalidasi di kode (lib/poStatusFlow.ts), bukan Prisma enum
  approvalStrategyId   String?   // strategi yang cocok sesuai totalAmount saat submit
  submittedAt          DateTime? // dipakai buat scoping siklus approval (resubmit setelah REJECTED)
  totalAmount          Decimal   @db.Decimal(15, 2) @default(0) // auto-calculated, sum dari POLine.totalPrice
  deliveryDate         DateTime?
  notes                String?
  isDeleted            Boolean   @default(false)
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  sentAt               DateTime? // waktu PO ditransisikan ke PO_SENT (null kalau belum pernah dikirim)
  sentBy               String?   // user id yang trigger pengiriman — untuk audit trail siapa yang kirim ke vendor

  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  vendor           Vendor   @relation(fields: [vendorId], references: [id])
  creator          User     @relation(fields: [createdBy], references: [id])
  approvalStrategy ApprovalStrategy? @relation(fields: [approvalStrategyId], references: [id])
  lines            POLine[]
  approvalLogs     ApprovalLog[]
  goodsReceipts    GoodsReceipt[]
  invoices         Invoice[]
  sender           User? @relation("PurchaseOrderSender", fields: [sentBy], references: [id])

  @@index([tenantId])
  @@unique([tenantId, poNumber]) // poNumber unik per tenant
}

model POLine {
  id          String  @id @default(uuid())
  poId        String
  itemId      String
  description String?
  quantity    Decimal @db.Decimal(15, 2)
  uom         String
  unitPrice   Decimal @db.Decimal(15, 2)
  totalPrice  Decimal @db.Decimal(15, 2) // auto-calculated: quantity * unitPrice, dihitung di API, bukan trigger DB

  po           PurchaseOrder @relation(fields: [poId], references: [id])
  item         Item          @relation(fields: [itemId], references: [id])
  grLines      GRLine[]
  invoiceLines InvoiceLine[]

  @@index([poId])
}

model GoodsReceipt {
  id          String   @id @default(uuid())
  tenantId    String
  grNumber    String   // format: GR-YYYYMM-0001, auto-generated per tenant, reset bulanan
  poId        String
  receivedBy  String   // SELALU dari session.user.id — endpoint menolak jika field ini dikirim manual di body
  receiptDate DateTime
  notes       String?
  createdAt   DateTime @default(now())
  // Sengaja TIDAK ADA updatedAt/isDeleted/deletedAt: GR sama sekali tidak punya
  // endpoint update/delete, jadi field-field itu tidak akan pernah terpakai.

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  po       PurchaseOrder @relation(fields: [poId], references: [id])
  receiver User          @relation(fields: [receivedBy], references: [id])
  lines    GRLine[]

  @@index([tenantId])
  @@index([poId])
  @@unique([tenantId, grNumber])
}

model GRLine {
  id               String    @id @default(uuid())
  grId             String
  poLineId         String    // referensi ke PO Line spesifik, bukan itemId langsung
  batchNumber      String    // nomor lot/batch dari vendor atau internal
  expiryDate       DateTime? // opsional — tidak semua item butuh (jasa, alat non-consumable, dll)
  quantityOrdered  Decimal   @db.Decimal(15, 2) // snapshot POLine.quantity saat GR dibuat — audit trail saja, BUKAN sumber validasi
  quantityReceived Decimal   @db.Decimal(15, 2) // qty diterima untuk batch ini
  notes            String?

  goodsReceipt GoodsReceipt @relation(fields: [grId], references: [id])
  poLine       POLine       @relation(fields: [poLineId], references: [id])

  @@index([grId])
  @@index([poLineId])
  // Sengaja TIDAK ADA @@unique — 1 PO Line boleh terima batch yang sama
  // di GR berbeda (restock lanjutan dari batch produksi sama), dan 1 GR
  // boleh punya beberapa baris untuk poLineId yang sama (multi-batch split)
}

// ============================================================
// W4T1 — Invoice module (SAP MIRO — Logistics Invoice Verification pattern)
// ============================================================

// Header invoice. Merujuk ke PurchaseOrder (BUKAN GoodsReceipt langsung) —
// supaya 1 invoice bisa mengonsolidasi beberapa GR sekaligus, atau
// menginvoice sebagian dari 1 GR, sesuai kebiasaan vendor riil.
// Vendor TIDAK di-duplicate di sini — selalu diturunkan dari po.vendorId,
// konsisten dengan pola GoodsReceipt yang juga tidak duplicate vendorId.
model Invoice {
  id            String    @id @default(uuid())
  tenantId      String
  invoiceNumber String    // format: INV-YYYYMM-0001, auto-generated per tenant, reset bulanan
  poId          String
  status        String    @default("DRAFT") // divalidasi di kode (lib/invoiceStatusFlow.ts), bukan Prisma enum

  invoiceDate DateTime  // tanggal di kertas invoice vendor — beda dari createdAt (kapan dicatat di sistem)
  dueDate     DateTime? // manual input untuk MVP; auto-calculate dari vendor.paymentTerms didefer
                         // (paymentTerms masih free-text string, belum terstruktur ke jumlah hari)

  totalAmount Decimal @db.Decimal(15, 2) @default(0) // auto-calculated, sum dari InvoiceLine.totalPrice
  notes       String?

  createdBy   String    // user yang input invoice (biasanya role finance)
  submittedAt DateTime? // waktu status DRAFT -> SUBMITTED, sistem jalankan matching di titik ini
  submittedBy String?
  resolvedAt  DateTime? // waktu status DISPUTED -> MATCHED lewat resolve manual
  resolvedBy  String?   // WAJIB permission invoice.resolve_dispute — dicek di endpoint, bukan di schema
  paidAt      DateTime? // waktu status MATCHED -> PAID
  paidBy      String?

  isDeleted Boolean   @default(false) // hanya dipakai untuk hapus invoice yang MASIH DRAFT (belum submit)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  po        PurchaseOrder @relation(fields: [poId], references: [id])
  creator   User     @relation("InvoiceCreator", fields: [createdBy], references: [id])
  submitter User?    @relation("InvoiceSubmitter", fields: [submittedBy], references: [id])
  resolver  User?    @relation("InvoiceResolver", fields: [resolvedBy], references: [id])
  payer     User?    @relation("InvoicePayer", fields: [paidBy], references: [id])
  lines     InvoiceLine[]

  @@index([tenantId])
  @@index([poId])
  @@unique([tenantId, invoiceNumber]) // invoiceNumber unik per tenant
}

model InvoiceLine {
  id         String  @id @default(uuid())
  invoiceId  String
  poLineId   String  // referensi ke PO Line spesifik — dipakai buat validasi cumulative terhadap GRLine
  quantity   Decimal @db.Decimal(15, 2) // qty yang diinvoice pada baris ini
  unitPrice  Decimal @db.Decimal(15, 2) // harga di invoice vendor — BOLEH beda dari POLine.unitPrice
                                          // (perbedaan inilah yang memicu status DISPUTED saat submit,
                                          // dicek di lib/invoiceMatching.ts, task berikutnya)
  totalPrice Decimal @db.Decimal(15, 2) // auto-calculated: quantity * unitPrice, dihitung di API
  notes      String?

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  poLine  POLine  @relation(fields: [poLineId], references: [id])

  @@index([invoiceId])
  @@index([poLineId])
  // Sengaja TIDAK ADA @@unique([invoiceId, poLineId]) — 1 invoice bisa punya
  // beberapa baris untuk poLineId yang sama kalau vendor split harga per
  // batch pengiriman berbeda (jarang, tapi tidak mau di-block di level DB)
}


// Katalog permission yang dikenal sistem. GLOBAL (bukan per-tenant) —
// tenant tidak bisa bikin permission baru sendiri, hanya assign/revoke
// yang sudah ada di katalog ini. Nambah permission baru = insert row baru
// via seed, BUKAN migration schema (append-only by design).
model Permission {
  id          String @id @default(uuid())
  key         String @unique // contoh: "invoice.resolve_dispute", "po.send" — dipakai di kode, bukan id
  description String          // ditampilkan di UI admin, contoh: "Boleh resolve selisih harga invoice"
  category    String          // "invoice" | "purchase_order" | "goods_receipt" | "master_data" — buat grouping di UI matrix

  rolePermissions RolePermission[]

  @@index([category])
}

// Mapping role -> permission, PER TENANT — inilah yang bikin adjustable per tenant.
// Tenant A bisa kasih "admin" akses invoice.resolve_dispute, tenant B tidak.
//
// PENTING: akses untuk mengubah RolePermission ITU SENDIRI (endpoint PUT
// /api/role-permissions) TIDAK dicek lewat tabel ini — tetap hardcode
// role === "admin" di kode. Ini disengaja untuk mencegah lockout: kalau
// akses RBAC management bisa dicabut lewat RBAC itu sendiri, admin bisa
// tidak sengaja mengunci dirinya sendiri tanpa jalan keluar selain edit DB
// manual. Pola ini sama seperti "break glass" access di sistem otorisasi
// manapun (termasuk SAP PFCG — role SAP_ALL/superuser tidak diatur lewat
// role assignment biasa).
model RolePermission {
  id           String @id @default(uuid())
  tenantId     String
  role         String // "admin" | "purchasing" | "warehouse" | "finance" — string bebas, konsisten dengan User.role
  permissionId String

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([tenantId, role, permissionId])
  @@index([tenantId])
}

model User {
  id        String  @id @default(uuid())
  tenantId  String
  name      String
  email     String  @unique
  password  String
  role      String  // "admin", "purchasing", "warehouse", "finance"
  isActive  Boolean @default(true)

  tenant   Tenant  @relation(fields: [tenantId], references: [id])

  approvalLevels        ApprovalLevelUser[]
  approvalLogs          ApprovalLog[]
  createdPurchaseOrders PurchaseOrder[]
  sentPurchaseOrders    PurchaseOrder[] @relation("PurchaseOrderSender")
  goodsReceipts         GoodsReceipt[]
  createdInvoices       Invoice[] @relation("InvoiceCreator")   
  submittedInvoices     Invoice[] @relation("InvoiceSubmitter") 
  resolvedInvoices      Invoice[] @relation("InvoiceResolver")  
  paidInvoices          Invoice[] @relation("InvoicePayer")     


  @@index([tenantId])
}

model Vendor {
  id           String    @id @default(uuid())
  tenantId     String
  code         String
  name         String
  contactName  String?
  phone        String?
  email        String?
  address      String?
  paymentTerms String?
  isActive     Boolean   @default(true)
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?

  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  purchaseOrders PurchaseOrder[]

  @@index([tenantId])
  @@unique([tenantId, code])
}

model Item {
  id          String  @id @default(uuid())
  tenantId    String
  code        String
  name        String
  description String?
  uom         String
  category    String?
  isActive    Boolean @default(true)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?

  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  poLines     POLine[]

  @@index([tenantId])
  @@unique([tenantId, code])
}

model Tenant{
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  plan      String    @default("free")
  createdAt DateTime  @default(now())   

  users              User[]
  Vendor             Vendor[]
  Item               Item[]
  approvalLevels     ApprovalLevel[]
  approvalStrategies ApprovalStrategy[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  invoices           Invoice[]
  rolePermissions    RolePermission[]
}